# Copy to .env.local and fill with your staging values. Never commit .env.local.

# Crossmint staging - CLIENT key for the browser SDK (must be ck_, NOT sk_).
NEXT_PUBLIC_CROSSMINT_API_KEY=ck_staging_xxx

# Crossmint staging - SERVER key (server-side only, never prefix with NEXT_PUBLIC_).
CROSSMINT_SERVER_API_KEY=sk_staging_xxx

# Crossmint API base URL (optional, defaults to staging).
CROSSMINT_API_URL=https://staging.crossmint.com/api/2025-06-09

# Firebase service account JSON (optional). Used to verify ID tokens server-side.
# If omitted, the project id above is enough to verify tokens. Set this in production.
FIREBASE_SERVICE_ACCOUNT=

# Firebase (3P auth provider). Public client config, safe for the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
